              <ownedParameter xmi:id="_0NL-j3NyEfCTGutOISnrsw" type="_0LD3kHNyEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>List&lt;MedicalRecord> records = service.getRecordsByPatientId(patientId);&#xD;
     if (records.isEmpty()) {&#xD;
         return ResponseEntity.noContent().build();&#xD;
     }&#xD;
     return ResponseEntity.ok(records);&#xD;
 </body>
            </ownedBehavior>
