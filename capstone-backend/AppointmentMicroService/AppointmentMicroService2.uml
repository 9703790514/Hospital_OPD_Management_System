            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="__7oU6HNtEfCTGutOISnrsw" name="updateAppointmentStatus" specification="__yHMgHNtEfCTGutOISnrsw">
              <ownedParameter xmi:id="__7oU6XNtEfCTGutOISnrsw" name="appointmentId">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="__7oU6nNtEfCTGutOISnrsw" name="newStatus">
