              <ownedParameter xmi:id="_PDj4JnOAEfCTGutOISnrsw" type="_PAYBQHOAEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>return roleRepository.findById(id)&#xD;
             .map(existingRole -> {&#xD;
                 existingRole.setName(role.getName());&#xD;
                 existingRole.setDescription(role.getDescription());&#xD;
                 return roleRepository.save(existingRole);&#xD;
             }).orElse(null);&#xD;
 </body>
            </ownedBehavior>
