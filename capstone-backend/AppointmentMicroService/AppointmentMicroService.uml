            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_FbVkAHNcEfC0VqedU-LfKg" name="updateAppointmentStatus" specification="_FL8dIHNcEfC0VqedU-LfKg">
              <ownedParameter xmi:id="_FbVkAXNcEfC0VqedU-LfKg" name="appointmentId">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_FbVkAnNcEfC0VqedU-LfKg" name="newStatus">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_FbVkA3NcEfC0VqedU-LfKg" type="_FJaGgHNcEfC0VqedU-LfKg" direction="return"/>
              <language>java</language>
              <body>Optional&lt;Appointment> optionalAppointment = appointmentRepository.findById(appointmentId);&#xD;
     if (optionalAppointment.isPresent()) {&#xD;
         Appointment existingAppointment = optionalAppointment.get();&#xD;
         existingAppointment.setStatus(newStatus);&#xD;
         // Optionally, update 'updatedAt' timestamp here&#xD;
         return appointmentRepository.save(existingAppointment);&#xD;
     }&#xD;
     return null; // Appointment not found&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_FbWLEHNcEfC0VqedU-LfKg" name="deleteAppointmentById" specification="_FMAukHNcEfC0VqedU-LfKg">
              <ownedParameter xmi:id="_FbWLEXNcEfC0VqedU-LfKg" name="id">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <language>java</language>
              <body>appointmentRepository.deleteById(id);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_FbWLEnNcEfC0VqedU-LfKg" name="getAllAppointments" specification="_FMCjwnNcEfC0VqedU-LfKg">
