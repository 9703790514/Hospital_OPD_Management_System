            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_Fa9wkHNcEfC0VqedU-LfKg" name="getAllAppointments" specification="_FIHGAHNcEfC0VqedU-LfKg">
              <ownedParameter xmi:id="_Fa9wkXNcEfC0VqedU-LfKg" type="_FV31MHNcEfC0VqedU-LfKg" direction="return"/>
              <language>java</language>
              <body>List&lt;Appointment> appointments = appointmentService.getAllAppointments();&#xD;
     return ResponseEntity.ok(appointments);&#xD;
 </body>
