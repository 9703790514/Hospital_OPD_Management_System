              <ownedParameter xmi:id="__7hnM3NtEfCTGutOISnrsw" type="__5iqM3NtEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>Optional&lt;Appointment> existing = appointmentService.getAppointmentById(id);&#xD;
     if (!existing.isPresent()) {&#xD;
         return ResponseEntity.notFound().build();&#xD;
     }&#xD;
     updatedAppointment.setId(id);&#xD;
     Appointment savedAppointment = appointmentService.updateAppointment(updatedAppointment);&#xD;
     return ResponseEntity.ok(savedAppointment);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="__7hnNHNtEfCTGutOISnrsw" name="updateAppointmentStatus" specification="__6bbAHNtEfCTGutOISnrsw">
              <ownedParameter xmi:id="__7hnNXNtEfCTGutOISnrsw" name="id">
