            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_tX7gdnN-EfCTGutOISnrsw" name="getAll" specification="_tVdbQHN-EfCTGutOISnrsw">
              <ownedParameter xmi:id="_tX7gd3N-EfCTGutOISnrsw" type="_tVnMQHN-EfCTGutOISnrsw" isOrdered="true" direction="return">
