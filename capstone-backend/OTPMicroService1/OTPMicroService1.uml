          <packagedElement xmi:type="uml:Class" xmi:id="_u8EpMHN9EfCTGutOISnrsw" name="SmsSenderService">
            <ownedAttribute xmi:id="_u_NcwHN9EfCTGutOISnrsw" name="fromPhoneNumber" visibility="private">
              <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
