            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="__7hAL3NtEfCTGutOISnrsw" name="getAppointmentsByDoctorAndDate" specification="__w5EgHNtEfCTGutOISnrsw">
              <ownedParameter xmi:id="__7hAMHNtEfCTGutOISnrsw" name="doctorId">
