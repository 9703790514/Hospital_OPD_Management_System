        <packagedElement xmi:type="uml:Package" xmi:id="_jUQvAHNxEfCTGutOISnrsw" name="controller">
          <packagedElement xmi:type="uml:Class" xmi:id="_jVVGAHNxEfCTGutOISnrsw" name="AuthController">
            <ownedAttribute xmi:id="_jbTyMHNxEfCTGutOISnrsw" name="authService" visibility="private" type="_jWBCgHNxEfCTGutOISnrsw" association="_jb-gkHNxEfCTGutOISnrsw"/>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_jby6Y3NxEfCTGutOISnrsw" name="login" specification="_jaWv8HNxEfCTGutOISnrsw">
              <ownedParameter xmi:id="_jby6ZHNxEfCTGutOISnrsw" name="loginRequest" type="_jVYwYHNxEfCTGutOISnrsw"/>
              <ownedParameter xmi:id="_jby6ZXNxEfCTGutOISnrsw" type="_jaU6wXNxEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>if (loginRequest.getEmail() == null || loginRequest.getEmail().isEmpty() ||&#xD;
         loginRequest.getPassword() == null || loginRequest.getPassword().isEmpty()) {&#xD;
         return ResponseEntity.badRequest().body(&quot;Email and password are required.&quot;);&#xD;
     }&#xD;
&#xD;
     try {&#xD;
         LoginResponse response = authService.authenticateUser(loginRequest);&#xD;
         return ResponseEntity.ok(response);&#xD;
     } catch (RuntimeException e) {&#xD;
         return ResponseEntity.status(401).body(e.getMessage());&#xD;
     } catch (Exception e) {&#xD;
         return ResponseEntity.status(500).body(&quot;An unexpected error occurred: &quot; + e.getMessage());&#xD;
     }&#xD;
 </body>
            </ownedBehavior>
            <ownedOperation xmi:id="_jaWv8HNxEfCTGutOISnrsw" name="login" method="_jby6Y3NxEfCTGutOISnrsw">
