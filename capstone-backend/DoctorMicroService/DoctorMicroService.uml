            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_XhJYMHNvEfCTGutOISnrsw" name="updateDoctor" specification="_Xft01XNvEfCTGutOISnrsw">
              <ownedParameter xmi:id="_XhJYMXNvEfCTGutOISnrsw" name="id">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_XhJYMnNvEfCTGutOISnrsw" name="doctor" type="_XYGJ4HNvEfCTGutOISnrsw"/>
              <ownedParameter xmi:id="_XhJYM3NvEfCTGutOISnrsw" type="_XYGJ4HNvEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>Optional&lt;Doctor> existingOpt = doctorRepository.findById(id);&#xD;
     if (existingOpt.isPresent()) {&#xD;
         Doctor existing = existingOpt.get();&#xD;
         existing.setFirstName(doctor.getFirstName());&#xD;
         existing.setLastName(doctor.getLastName());&#xD;
         existing.setSpecialization(doctor.getSpecialization());&#xD;
         existing.setContactNumber(doctor.getContactNumber());&#xD;
         existing.setEmail(doctor.getEmail());&#xD;
         existing.setLicenseNumber(doctor.getLicenseNumber());&#xD;
         existing.setConsultationFee(doctor.getConsultationFee());&#xD;
         existing.setUpdatedAt(Instant.now());&#xD;
         // Ensure customId is not accidentally overwritten if you want it to be immutable&#xD;
         // existing.setCustomId(doctor.getCustomId()); // Only if you allow updating customId&#xD;
         return doctorRepository.save(existing);&#xD;
     }&#xD;
     throw new RuntimeException(&quot;Doctor not found with id: &quot; + id);&#xD;
 </body>
            </ownedBehavior>
