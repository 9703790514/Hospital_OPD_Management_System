              </ownedParameter>
              <ownedParameter xmi:id="_Fa_lwnNcEfC0VqedU-LfKg" type="_FV31MHNcEfC0VqedU-LfKg" direction="return"/>
              <language>java</language>
              <body>List&lt;Appointment> appointments = appointmentService.getAppointmentsByPatientId(patientId);&#xD;
     // It's generally better to return an empty list with 200 OK than 204 No Content for lists&#xD;
     return ResponseEntity.ok(appointments);&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_FbAM0HNcEfC0VqedU-LfKg" name="getAppointmentsByDoctor" specification="_FIoDYHNcEfC0VqedU-LfKg">
              <ownedParameter xmi:id="_FbAM0XNcEfC0VqedU-LfKg" name="doctorId">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
