              <body>User updated = userService.updateUser(id, user);&#xD;
     return updated != null ? ResponseEntity.ok(updated) : ResponseEntity.notFound().build();&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_K9iBg3OBEfCTGutOISnrsw" name="patchUser" specification="_K9OfdXOBEfCTGutOISnrsw">
