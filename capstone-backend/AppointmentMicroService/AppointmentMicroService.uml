            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_Fa9JgHNcEfC0VqedU-LfKg" name="AppointmentController" specification="_FWHs0HNcEfC0VqedU-LfKg">
              <ownedParameter xmi:id="_Fa9JgXNcEfC0VqedU-LfKg" name="appointmentService" type="_FLIk0HNcEfC0VqedU-LfKg"/>
              <ownedParameter xmi:id="_Fa9JgnNcEfC0VqedU-LfKg" type="_FIAYUHNcEfC0VqedU-LfKg" direction="return"/>
              <language>java</language>
              <body>this.appointmentService = appointmentService;&#xD;
 </body>
