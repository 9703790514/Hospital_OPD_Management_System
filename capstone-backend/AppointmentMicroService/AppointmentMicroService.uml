              </ownedParameter>
              <ownedParameter xmi:id="_Fa--uHNcEfC0VqedU-LfKg" type="_FV31MHNcEfC0VqedU-LfKg" direction="return"/>
              <language>java</language>
              <body>Optional&lt;Appointment> appointment = appointmentService.getAppointmentById(id);&#xD;
     return appointment.map(ResponseEntity::ok).orElseGet(() -> ResponseEntity.notFound().build());&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_Fa_lwHNcEfC0VqedU-LfKg" name="getAppointmentsByPatient" specification="_FIfggHNcEfC0VqedU-LfKg">
