# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/OPD

# Service Ports
LOGIN_SERVICE_PORT=2003
APPOINTMENT_SERVICE_PORT=2001
USERS_SERVICE_PORT=2002
PATIENT_SERVICE_PORT=2004
DOCTOR_SERVICE_PORT=2005
MEDICAL_RECORD_SERVICE_PORT=2006
DOCTOR_RATING_SERVICE_PORT=2007
BILL_SERVICE_PORT=2009
OTP_SERVICE_PORT=1009
REGISTRATION_SERVICE_PORT=2010
ROLES_SERVICE_PORT=2011
NURSE_CHECKUP_SERVICE_PORT=2012
EMAIL_SERVICE_PORT=1111

# Email Service Configuration (Gmail example)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEBUG=false
MAIL_FROM=your-email@gmail.com

# Twilio Configuration (for SMS/OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Configuration
JWT_SECRET=your-secure-random-secret-key-min-256-bits
JWT_EXPIRATION_MS=86400000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,https://your-production-domain.com
