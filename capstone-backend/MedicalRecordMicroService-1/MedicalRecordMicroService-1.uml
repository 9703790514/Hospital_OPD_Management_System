            <ownedAttribute xmi:id="_0NBmcHNyEfCTGutOISnrsw" name="service" visibility="private" isLeaf="true" type="_0E4XEHNyEfCTGutOISnrsw" isReadOnly="true" association="_0OzIEXNyEfCTGutOISnrsw"/>
            <ownedAttribute xmi:id="_0NBmcXNyEfCTGutOISnrsw" name="fileStorageLocation" visibility="private" isLeaf="true" type="_0LiYsXNyEfCTGutOISnrsw" isReadOnly="true" association="_0O4AkHNyEfCTGutOISnrsw"/>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_0NPB7nNyEfCTGutOISnrsw" name="DiagnosticTestController" specification="_0LpGYXNyEfCTGutOISnrsw">
              <ownedParameter xmi:id="_0NPB73NyEfCTGutOISnrsw" name="service" type="_0E4XEHNyEfCTGutOISnrsw"/>
              <ownedParameter xmi:id="_0NPB8HNyEfCTGutOISnrsw" type="_0GIUQHNyEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>this.service = service;&#xD;
     // Define and create the directory to store uploaded files.&#xD;
     this.fileStorageLocation = Paths.get(&quot;uploads&quot;).toAbsolutePath().normalize();&#xD;
     Files.createDirectories(this.fileStorageLocation);&#xD;
 </body>
