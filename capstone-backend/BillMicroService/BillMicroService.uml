              <ownedParameter xmi:id="_X182cnNiEfCTGutOISnrsw" type="_XxkswHNiEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>Optional&lt;Bill> opt = service.findByMongoId(id);&#xD;
     return opt.map(ResponseEntity::ok)&#xD;
             .orElse(ResponseEntity.notFound().build());&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_X182c3NiEfCTGutOISnrsw" name="getById" specification="_XoXGYHNiEfCTGutOISnrsw">
