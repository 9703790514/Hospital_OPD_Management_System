          <packagedElement xmi:type="uml:Class" xmi:id="_Y-xZj3N_EfCTGutOISnrsw" name="PatientRegistrationController">
            <ownedAttribute xmi:id="_Y_73IHN_EfCTGutOISnrsw" name="logger" visibility="private" isLeaf="true" isStatic="true" type="_Y_vC03N_EfCTGutOISnrsw" isReadOnly="true" association="_ZAIrcHN_EfCTGutOISnrsw">
              <defaultValue xmi:type="uml:LiteralString" xmi:id="_Y_73IXN_EfCTGutOISnrsw" value="LoggerFactory.getLogger(PatientRegistrationController.class)"/>
            </ownedAttribute>
            <ownedAttribute xmi:id="_Y_73I3N_EfCTGutOISnrsw" name="patientRegistrationService" visibility="private" type="_Y-6jcHN_EfCTGutOISnrsw" association="_ZAKgoXN_EfCTGutOISnrsw"/>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_ZAFoI3N_EfCTGutOISnrsw" name="registerPatient" specification="_Y_vp43N_EfCTGutOISnrsw">
              <ownedParameter xmi:id="_ZAFoJHN_EfCTGutOISnrsw" name="request" type="_Y-yAl3N_EfCTGutOISnrsw"/>
              <ownedParameter xmi:id="_ZAFoJXN_EfCTGutOISnrsw" type="_Y_vp4XN_EfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>System.out.println(&quot;Received registration request for: &quot; + request.getEmail());&#xD;
 	&#xD;
     // Basic validation for critical fields before calling the service&#xD;
 	if (request.getEmail() == null || request.getEmail().isEmpty() ||&#xD;
         request.getUsername() == null || request.getUsername().isEmpty() ||&#xD;
         request.getPassword() == null || request.getPassword().isEmpty()) {&#xD;
         return ResponseEntity.badRequest().body(&quot;Username, email, and password are required.&quot;);&#xD;
     }&#xD;
&#xD;
     try {&#xD;
         // This is where the core logic and potential error resides&#xD;
         patientRegistrationService.registerPatient(request);&#xD;
         return ResponseEntity.ok(&quot;Patient registration successful.&quot;);&#xD;
     } catch (Exception e) {&#xD;
         // Log the full exception for debugging purposes&#xD;
         logger.error(&quot;Registration failed due to an unexpected server error.&quot;, e);&#xD;
&#xD;
         // Return a 500 status code with a user-friendly message&#xD;
         return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)&#xD;
                 .body(&quot;Registration failed: &quot; + e.getMessage());&#xD;
     }&#xD;
 </body>
            </ownedBehavior>
