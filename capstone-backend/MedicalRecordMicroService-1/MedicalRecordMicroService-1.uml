            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_0NL-iXNyEfCTGutOISnrsw" name="update" specification="_0LbrBXNyEfCTGutOISnrsw">
              <ownedParameter xmi:id="_0NL-inNyEfCTGutOISnrsw" name="id">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_0NL-i3NyEfCTGutOISnrsw" name="record" type="_0EJXQHNyEfCTGutOISnrsw"/>
              <ownedParameter xmi:id="_0NL-jHNyEfCTGutOISnrsw" type="_0LD3kHNyEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>return service.findById(id).map(existing -> {&#xD;
         record.setId(existing.getId());&#xD;
         MedicalRecord updated = service.save(record);&#xD;
         return ResponseEntity.ok(updated);&#xD;
     }).orElse(ResponseEntity.notFound().build());&#xD;
 </body>
            </ownedBehavior>
            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_0NL-jXNyEfCTGutOISnrsw" name="getByPatientId" specification="_0FcXwHNyEfCTGutOISnrsw">
              <ownedParameter xmi:id="_0NL-jnNyEfCTGutOISnrsw" name="patientId">
