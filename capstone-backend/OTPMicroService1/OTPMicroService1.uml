            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_u_SVQnN9EfCTGutOISnrsw" name="sendSms" specification="_u8FQQHN9EfCTGutOISnrsw">
              <ownedParameter xmi:id="_u_S8UHN9EfCTGutOISnrsw" name="toPhoneNumber">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_u_S8UXN9EfCTGutOISnrsw" name="messageBody">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              </ownedParameter>
              <ownedParameter xmi:id="_u_S8UnN9EfCTGutOISnrsw" direction="return">
                <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/JavaPrimitiveTypes.library.uml#boolean"/>
              </ownedParameter>
              <language>java</language>
              <body>try {&#xD;
         Message message = Message.creator(&#xD;
                 new PhoneNumber(toPhoneNumber),&#xD;
                 new PhoneNumber(fromPhoneNumber),&#xD;
                 messageBody)&#xD;
             .create();&#xD;
 &#xD;
         System.out.println(&quot;SMS sent, SID: &quot; + message.getSid());&#xD;
         return true;  // success&#xD;
     } catch (Exception e) {&#xD;
         System.err.println(&quot;Failed to send SMS: &quot; + e.getMessage());&#xD;
         return false; // failure&#xD;
     }&#xD;
 </body>
            </ownedBehavior>
