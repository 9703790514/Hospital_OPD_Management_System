              <ownedParameter xmi:id="__7hnN3NtEfCTGutOISnrsw" type="__5iqM3NtEfCTGutOISnrsw" direction="return"/>
              <language>java</language>
              <body>String newStatus = statusUpdate.get(&quot;status&quot;);&#xD;
     if (newStatus == null || newStatus.isEmpty()) {&#xD;
         return ResponseEntity.badRequest().body(null);&#xD;
     }&#xD;
     Appointment updated = appointmentService.updateAppointmentStatus(id, newStatus);&#xD;
     if (updated != null) {&#xD;
         return ResponseEntity.ok(updated);&#xD;
     }&#xD;
     return ResponseEntity.notFound().build();&#xD;
 </body>
            </ownedBehavior>
