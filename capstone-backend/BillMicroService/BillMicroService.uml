            <ownedAttribute xmi:id="_X0DZAHNiEfCTGutOISnrsw" name="uploadDir" visibility="private" isLeaf="true" isReadOnly="true">
              <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#String"/>
              <defaultValue xmi:type="uml:LiteralString" xmi:id="_X0DZAXNiEfCTGutOISnrsw" value="&quot;uploads/bill_documents/&quot;"/>
