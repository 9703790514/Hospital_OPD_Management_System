            <ownedBehavior xmi:type="uml:OpaqueBehavior" xmi:id="_FbU89XNcEfC0VqedU-LfKg" name="updateAppointment" specification="_FXV00HNcEfC0VqedU-LfKg">
              <ownedParameter xmi:id="_FbU89nNcEfC0VqedU-LfKg" name="appointment" type="_FJaGgHNcEfC0VqedU-LfKg"/>
